{
  "name": "warrant",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-gated execution of bounded AI work, with a reproducible fault-injection benchmark",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:upstream-parity": "node third_party/citadel/scripts/test-operation-recovery.js && node third_party/citadel/scripts/test-operation-chaos.js",
    "check": "node scripts/check.js",
    "coverage": "node --test --experimental-test-coverage --test-reporter=spec \"test/**/*.test.js\"",
    "example": "node bin/warrant.js run examples/pipeline/spec.json --dir .warrant",
    "example:lying": "node bin/warrant.js run examples/pipeline/spec-lying.json --dir .warrant",
    "gen:workloads": "node scripts/gen-workloads.js",
    "bench:dev": "node bin/warrant.js bench --seeds dev --out results/dev",
    "bench:final": "node bin/warrant.js bench --seeds final --out results/final",
    "bench:partial": "node bin/warrant.js bench --seeds partial-requirements --out results/partial-requirements",
    "bench:overhead": "node scripts/bench-overhead.js 9",
    "profile:bench": "node scripts/profile-bench.js 100"
  },
  "bin": {
    "warrant": "bin/warrant.js"
  }
}
